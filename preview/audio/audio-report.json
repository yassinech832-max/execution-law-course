{
  "status": "PASS",
  "voice": "ar-SA-HamedNeural",
  "naturalSpeechSeconds": 62.80800000000001,
  "tempo": 1.0645423728813561,
  "durationSeconds": 60,
  "captions": [
    {
      "start": 0.096402827657023,
      "end": 4.921691548836743,
      "text": "مرحباً بكم في مساق التَّنفيذ الجَبْري نبدأ اليوم بالسَّنَد"
    },
    {
      "start": 4.931691548836743,
      "end": 10.397238769241376,
      "text": "التَّنفيذي بالاستناد إلى كتاب الوجيز في قانون التنفيذ الجبري للأستاذ"
    },
    {
      "start": 10.407238769241376,
      "end": 16.082892018913373,
      "text": "الدكتور أحمد خليل هل يكفي أن يكون للدائن حقٌّ ثابت حتى"
    },
    {
      "start": 16.092892018913375,
      "end": 17.980394300729543,
      "text": "تبدأ إجراءات التنفيذ"
    },
    {
      "start": 19.03119467001716,
      "end": 24.746429307487947,
      "text": "يوضح المؤلف أن إثبات الحق وحده لا يكفي فلا بد من سَنَدٍ أضفى"
    },
    {
      "start": 24.75642930748795,
      "end": 30.4320929192229,
      "text": "عليه التشريع الصفة التنفيذية وهنا نميز بين أمرين الحقُّ"
    },
    {
      "start": 30.4420929192229,
      "end": 36.01291364825263,
      "text": "الموضوعي ومصدره كالعقد أو الفعل الضار والحقُّ في التنفيذ الجبري"
    },
    {
      "start": 36.09068986972319,
      "end": 41.679813879181275,
      "text": "ومصدره السند التنفيذي فوجود ورقة تثبت الدين لا يجعلها"
    },
    {
      "start": 41.68981387918127,
      "end": 43.91107057218631,
      "text": "تلقائياً سنداً تنفيذياً"
    },
    {
      "start": 44.95494458407354,
      "end": 50.914880183099164,
      "text": "قبل متابعة الدرس تأمل هذا السؤال ما الفرق بين إثبات الحق وامتلاك"
    },
    {
      "start": 50.92488018309916,
      "end": 56.57830663984443,
      "text": "الحق في طلب الحماية التنفيذية دوّن إجابتك ثم ارجع إلى"
    },
    {
      "start": 56.588306639844426,
      "end": 58.64885110323805,
      "text": "الفقرات المرتبطة بالوحدة"
    }
  ],
  "chapters": [
    {
      "start": 0,
      "end": 18.934791666666666,
      "title": "السَّنَد التَّنفيذي"
    },
