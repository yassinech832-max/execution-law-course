    {
      "start": 0.10031273193919073,
      "end": 5.095970350283699,
      "text": "مرحباً بكم في مساق التَّنفيذ الجَبْري نبدأ اليوم بالسَّنَد"
    },
    {
      "start": 5.105970350283699,
      "end": 10.267673106781578,
      "text": "التَّنفيذي بالاستناد إلى المادة العلمية لمقرر التنفيذ الجبري"
    },
    {
      "start": 11.047962892416036,
      "end": 16.273933242699737,
      "text": "هل يكفي أن يكون للدائن حقٌّ ثابت حتى تبدأ إجراءات التنفيذ"
    },
    {
      "start": 17.35518770771058,
      "end": 23.341182973385703,
      "text": "يوضح المقرر أن إثبات الحق وحده لا يكفي فلا بد من سَنَدٍ أضفى"
    },
    {
      "start": 23.351182973385704,
      "end": 29.257433424121462,
      "text": "عليه التشريع الصفة التنفيذية وهنا نميز بين أمرين الحقُّ"
    },
    {
      "start": 29.267433424121464,
      "end": 35.059357796475524,
      "text": "الموضوعي ومصدره كالعقد أو الفعل الضار والحقُّ في التنفيذ الجبري"
    },
    {
      "start": 35.14511492166994,
      "end": 40.961356160451295,
      "text": "ومصدره السند التنفيذي فوجود ورقة تثبت الدين لا يجعلها"
    },
    {
      "start": 40.97135616045129,
      "end": 43.27779099834743,
      "text": "تلقائياً سنداً تنفيذياً"
    },
    {
      "start": 44.36910434465171,
      "end": 49.81373941335864,
      "text": "قبل متابعة الدرس تأمل هذا السؤال ما الفرق بين إثبات الحق"
    },
    {
      "start": 49.93810745047374,
      "end": 55.84692200218024,
      "text": "وامتلاك الحق في طلب الحماية التنفيذية دوّن إجابتك ثم"
    },
    {
      "start": 55.85692200218024,
      "end": 58.61352039223999,
      "text": "ارجع إلى الفقرات المرتبطة بالوحدة"
